<resources>

    <!-- Physical corner radius of the built-in display -->
    <dimen name="rounded_corner_radius">108px</dimen>
    <dimen name="rounded_corner_radius_top">108px</dimen>
    <dimen name="rounded_corner_radius_bottom">108px</dimen>

    <!-- Content inset to prevent status bar icons from clipping into corners -->
    <dimen name="rounded_corner_content_padding">69px</dimen>

    <!-- Status bar height matched to the centered camera cutout -->
    <dimen name="status_bar_height_default">127px</dimen>
    <dimen name="status_bar_height_portrait">127px</dimen>
    <dimen name="status_bar_height_landscape">28dp</dimen>

    <!-- Rounded corner radius adjustment -->
    <dimen name="rounded_corner_radius_adjustment">5px</dimen>

    <!-- Stock notification layout density -->
    <dimen name="notification_min_height">106dp</dimen>
</resources>